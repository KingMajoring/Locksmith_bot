# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# App database (Postgres in Azure; sqlite by default for local dev)
DATABASE_URL=sqlite:///db.sqlite3

# Handl/Soter (read-only Azure SQL access, via pymssql) — leave
# HANDL_SQL_SERVER unset to use the mock client in dev
HANDL_SQL_SERVER=
HANDL_SQL_PORT=1433
HANDL_SQL_DATABASE=
HANDL_SQL_USER=
HANDL_SQL_PASSWORD=

# Azure AD / Microsoft 365 login, restricted to WGTK email domain(s)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
ALLOWED_EMAIL_DOMAINS=wgtk.co.uk

# Outbound email for weekly stock-check sheets (Microsoft 365 SMTP relay)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=stock-checks@wgtk.co.uk

# Stock Accuracy (Area 1) tuning
STOCK_CHECK_LINES_PER_WEEK=10
STOCK_CHECK_POOL_SIZE=30
STOCK_CHECK_USAGE_WINDOW_DAYS=90
STOCK_CHECK_NO_REPEAT_WEEKS=4
# While set, every stock-check email redirects here instead of the
# real locksmith (clearly labelled in the subject). Unset once
# confident real SMTP delivery works and ready to go live.
STOCK_CHECK_TEST_REDIRECT_EMAIL=

# Optimo API (Area 2+)
OPTIMO_API_BASE_URL=
OPTIMO_API_KEY=
